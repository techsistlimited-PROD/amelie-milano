# CMS admin emails (comma-separated) — can sign in at /admin
CMS_ADMIN_EMAILS=techsistlimited@gmail.com

# Copy to .env on the VPS (never commit secrets).
# VITE_* values are baked into the client bundle at Docker build time.

# ── Public (client — required at build time) ───────────────────────────────────
# VITE_PUBLIC_BUILDER_KEY is no longer required (custom CMS replaces Builder.io)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional alias used by some Supabase setups:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server runtime ─────────────────────────────────────────────────────────────
PORT=3000
PUBLIC_SITE_URL=https://ameliemilano.com
PING_MESSAGE=ping pong

# Supabase (server-side — use service role for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_ANON_KEY=  # fallback if service role not set

# SSLCommerz (online payments)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Docker host port (docker-compose only — Caddy proxies to this)
HOST_PORT=3010
